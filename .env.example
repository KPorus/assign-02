APP_NAME=Blog API
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_WRITE=20/minute
# Local Docker Postgres for posts (host port 5433)
DATABASE_URL=postgresql://postgres:dev@localhost:5433/blog
# Supabase Auth + public.users profiles (use service_role key on the server)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
